<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:y="http://www.yworks.com/xml/graphml">
  <graph id="G" edgedefault="directed">
    <node id="root"><data><y:NodeLabel>fixture:module:jar:1</y:NodeLabel></data></node>
    <node id="a"><data><y:NodeLabel>fixture:lib:jar:1:compile</y:NodeLabel></data></node>
    <node id="b"><data><y:NodeLabel>fixture:lib:jar:1:compile</y:NodeLabel></data></node>
